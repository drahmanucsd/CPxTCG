{
  "name": "shed",
  "private": true,
  "version": "0.1.0",
  "description": "Shed — a jazz piano practice app",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @shed/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "theory": "tsx packages/theory/src/cli.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
